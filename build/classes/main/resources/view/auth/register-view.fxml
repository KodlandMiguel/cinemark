<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox prefHeight="500.0" prefWidth="400.0" spacing="15.0" style="-fx-background-color: #1a1a1a;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.mjlm.cinemark.controller.auth.RegisterController">
    <children>
        <HBox fx:id="windowHeader" alignment="CENTER_RIGHT" prefHeight="35.0" style="-fx-background-color: #111111;">
            <children>
                <Button fx:id="minimizeButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white;" text="-" />
                <Button fx:id="closeButton" mnemonicParsing="false" style="-fx-background-color: transparent; -fx-text-fill: white;" text="X" />
            </children>
            <padding>
                <Insets right="10.0" />
            </padding>
        </HBox>

        <VBox alignment="CENTER" spacing="15.0">
            <children>
                <Label text="Crear Cuenta en Cinemark" textFill="WHITE">
                    <font>
                        <Font name="System Bold" size="20.0" />
                    </font>
                </Label>

                <VBox alignment="CENTER_LEFT" maxWidth="300.0" spacing="10.0">
                    <children>
                        <Label text="Correo Electrónico" textFill="WHITE" />
                        <TextField fx:id="emailField" promptText="ejemplo@correo.com" style="-fx-background-radius: 15;" />

                        <Label text="Nickname" textFill="WHITE" />
                        <TextField fx:id="nicknameField" promptText="Usuario123" style="-fx-background-radius: 15;" />

                        <Label text="Contraseña" textFill="WHITE" />
                        <PasswordField fx:id="passwordField" promptText="••••••••" style="-fx-background-radius: 15;" />

                        <Label text="Confirmar Contraseña" textFill="WHITE" />
                        <PasswordField fx:id="confirmPasswordField" promptText="••••••••" style="-fx-background-radius: 15;" />
                    </children>
                </VBox>

                <Button fx:id="registerButton" defaultButton="true" prefHeight="35.0" prefWidth="300.0" style="-fx-background-color: #e50914; -fx-background-radius: 20; -fx-text-fill: white;" text="Registrarse">
                    <font>
                        <Font name="System Bold" size="14.0" />
                    </font>
                </Button>

                <HBox alignment="CENTER" spacing="5.0">
                    <children>
                        <Label text="¿Ya tienes cuenta?" textFill="#aaaaaa" />
                        <Hyperlink fx:id="loginHyperlink" text="Iniciar Sesión" textFill="#e50914" />
                    </children>
                </HBox>
            </children>
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="10.0" />
            </padding>
        </VBox>
    </children>
</VBox>